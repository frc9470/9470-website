---
import '../styles/applications.css';
interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
}

const {
  title = 'Team 9470',
  description = 'Ctrl-Alt-Defeat, FRC Team 9470, is a student-led robotics team from Fremont, California. We build competitive robots, train students in engineering and leadership, and expand access to hands-on STEM through community programs.',
  ogImage = '/assets/images/ctrlaltdefeatlogo.png',
  canonicalUrl = 'https://team9470.com',
} = Astro.props;
---

<meta http-equiv="content-language" content="en"/>
<meta http-equiv="content-type" content="text/html; charset=UTF-8"/>
<meta http-equiv="X-UA-Compatible" content="IE=edge"/>
<meta name="viewport" content="width=device-width,initial-scale=1.0,user-scalable=no"/>
<meta property="og:site_name" content="Team 9470">
<meta property="og:type" content="website">
<meta property="og:description" content={description}>
<meta property="og:title" content={title}>
<meta property="og:image" content={ogImage}>
<meta property="og:url" content={canonicalUrl}>
<meta name="description" content={description}>
<title>{title}</title>
<link rel="canonical" href={canonicalUrl}>
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image:src" content={ogImage} />
<link rel="shortcut icon" href="/assets/images/ctrlaltdefeatlogo.png">
<!-- Web Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;600;700&family=Noto+Sans+JP:wght@400;500;700&display=swap" rel="stylesheet">
<!-- End Web Fonts -->
<link href="/assets/css/common.css" rel="stylesheet" type="text/css"/>
<slot />
