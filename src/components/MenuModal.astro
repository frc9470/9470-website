---
interface Props { currentPage?: string; }
const { currentPage = '' } = Astro.props;
const links = [
  ['home', 'Home', '/'], ['about', 'About', '/about/'], ['media', 'Media', '/media/'],
  ['awards', 'Awards', '/awards/'], ['divisions', 'Divisions', '/divisions/'],
  ['members', 'Members', '/members/'], ['sponsors', 'Our Sponsors', '/sponsors/'], ['support', 'Support Us', '/support/'],
];
---
<dialog class="MobileMenu" id="MobileMenu" aria-labelledby="MobileMenuTitle">
  <div class="MobileMenu__header">
    <h2 id="MobileMenuTitle">Explore Team 9470</h2>
    <button type="button" class="MobileMenu__close" autofocus>Close <span aria-hidden="true">×</span></button>
  </div>
  <nav aria-label="All pages" class="MobileMenu__links">
    {links.map(([page, label, href]) => (
      <a href={href} aria-current={currentPage === page ? 'page' : undefined}>{label}<span aria-hidden="true">›</span></a>
    ))}
  </nav>
  <p class="MobileMenu__status">Applications are currently closed.</p>
</dialog>

<style>
.MobileMenu { display: none; }
@media (max-width: 767px) {
  .MobileMenu[open] {
    display: block;
    position: fixed;
    inset: auto 0 0;
    margin: 0 auto;
    box-sizing: border-box;
    width: 100%;
    max-width: 560px;
    max-height: calc(100vh - 24px);
    max-height: calc(100dvh - 24px);
    padding: 20px max(20px, env(safe-area-inset-right, 0px)) calc(24px + env(safe-area-inset-bottom, 0px)) max(20px, env(safe-area-inset-left, 0px));
    overflow-y: auto;
    overscroll-behavior: contain;
    border: 1px solid #d5d1c7;
    border-radius: 20px 20px 0 0;
    background: #f7f5ef;
    color: #24221c;
    box-shadow: 0 -12px 48px #0003;
    font-family: 'Montserrat', sans-serif;
  }
  .MobileMenu::backdrop { background: #0009; }
  .MobileMenu__header { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding-bottom: 16px; }
  .MobileMenu__header h2 { font-size: 18px; font-weight: 700; line-height: 1.4; }
  .MobileMenu__close { display: flex; align-items: center; justify-content: center; gap: 8px; min-height: 44px; padding: 0 12px; flex-shrink: 0; border: 1px solid #c9c4b8; border-radius: 8px; background: transparent; color: #24221c; font: 600 13px/1 'Montserrat', sans-serif; cursor: pointer; }
  .MobileMenu__close span { font-size: 24px; font-weight: 400; }
  .MobileMenu__links { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
  .MobileMenu__links a { display: flex; align-items: center; justify-content: space-between; gap: 8px; min-height: 52px; padding: 10px 12px; border: 1px solid #d5d1c7; border-radius: 8px; color: #37342d; background: transparent; text-decoration: none; font-size: 14px; font-weight: 600; line-height: 1.4; }
  .MobileMenu__links a[aria-current='page'] { background: #ece3ca; border-color: #b4a57c; color: #24221c; }
  .MobileMenu__links a span { font-size: 18px; }
  .MobileMenu__status { margin-top: 20px; color: #625e53; font-size: 12px; line-height: 1.6; }
  .MobileMenu :is(a, button):focus-visible { outline: 2px solid #57503c; outline-offset: 2px; }
}
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('#MobileMenu');
  const toggle = document.querySelector<HTMLButtonElement>('#MobileMenuToggle');
  if (dialog && toggle) {
    const mobile = window.matchMedia('(max-width: 767px)');
    let savedOverflow = '';
    let destination: string | null = null;
    const closeVisual = () => {
      if (!dialog.open) return;
      dialog.close();
      toggle.setAttribute('aria-expanded', 'false');
      document.documentElement.style.overflow = savedOverflow;
    };
    const dismiss = () => {
      closeVisual();
      if (history.state?.mobileNavMenu) history.back();
      else if (destination) window.location.assign(destination);
    };
    const openVisual = () => {
      if (!mobile.matches || dialog.open) return;
      savedOverflow = document.documentElement.style.overflow;
      dialog.showModal();
      document.documentElement.style.overflow = 'hidden';
      toggle.setAttribute('aria-expanded', 'true');
    };
    toggle.addEventListener('click', () => {
      if (!mobile.matches || dialog.open) return;
      openVisual();
      history.pushState({ ...history.state, mobileNavMenu: true }, '');
    });
    dialog.querySelector('button')?.addEventListener('click', dismiss);
    dialog.addEventListener('cancel', event => { event.preventDefault(); dismiss(); });
    dialog.addEventListener('keydown', event => {
      if (event.key !== 'Tab') return;
      const controls = [...dialog.querySelectorAll<HTMLElement>('button, a[href]')];
      const first = controls[0];
      const last = controls[controls.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });
    dialog.addEventListener('click', event => {
      if (event.target === dialog) {
        const bounds = dialog.getBoundingClientRect();
        if (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom) dismiss();
      }
      const link = (event.target as Element).closest('a');
      if (link && !event.metaKey && !event.ctrlKey && !event.shiftKey && !event.altKey && event.button === 0) {
        event.preventDefault();
        destination = link.href;
        dismiss();
      }
    });
    window.addEventListener('popstate', () => {
      if (history.state?.mobileNavMenu && !destination && mobile.matches) {
        openVisual();
        return;
      }
      closeVisual();
      if (destination) window.location.assign(destination);
    });
    window.addEventListener('pagehide', () => { destination = null; closeVisual(); });
    window.addEventListener('pageshow', () => {
      destination = null;
      closeVisual();
      if (history.state?.mobileNavMenu) {
        const { mobileNavMenu, ...state } = history.state;
        history.replaceState(state, '');
      }
    });
    mobile.addEventListener('change', () => { if (!mobile.matches && dialog.open) dismiss(); });
  }
</script>
