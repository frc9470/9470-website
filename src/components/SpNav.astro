---
interface Props {
  currentPage?: string;
}

const { currentPage = '' } = Astro.props;
---

<div class="SpNav SP" id="SpNav">
  <div class="SpNav__links">
    <ul class="list">
      <li class={`list__item ${currentPage === 'home' ? 'is-current' : ''}`}>
        <a class="anchor" href="/">
          <div class="anchor__inner">
            <figure class="ico"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 27 27"><path class="cls-2" d="M13.5,1.125L2,9.75V27h7.188v-10.062h8.625v10.062h7.188V9.75L13.5,1.125Z"/></svg></figure>
            <p class="text">Home</p>
          </div>
        </a>
      </li>
      <li class={`list__item ${currentPage === 'about' ? 'is-current' : ''}`}>
        <a class="anchor" href="/about/">
          <div class="anchor__inner">
            <figure class="ico"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 27 27"><path class="cls-2" d="M17.333,14.222V6.556l-3.833-3.833-3.833,3.833v2.556H2V27H25V14.222h-7.667ZM7.111,24.444h-2.556v-2.556h2.556v2.556Zm0-5.111h-2.556v-2.556h2.556v2.556Zm0-5.111h-2.556v-2.556h2.556v2.556Zm7.667,10.222h-2.556v-2.556h2.556v2.556Zm0-5.111h-2.556v-2.556h2.556v2.556Zm0-5.111h-2.556v-2.556h2.556v2.556Zm0-5.111h-2.556v-2.556h2.556v2.556Zm7.667,15.333h-2.556v-2.556h2.556v2.556Zm0-5.111h-2.556v-2.556h2.556v2.556Z"/></svg></figure>
            <p class="text">About</p>
          </div>
        </a>
      </li>
      <li class="list__item list__item--menu">
        <a class="anchor" href="#"><span class="MenuModal--open"></span><span class="MenuModal--close"></span>
          <div class="anchor__inner">
            <p class="text">Menu</p>
            <figure class="cross"></figure>
          </div>
        </a>
      </li>
      <li class={`list__item ${currentPage === 'media' ? 'is-current' : ''}`}>
        <a class="anchor" href="/media/">
          <div class="anchor__inner">
            <figure class="ico"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 27 27"><path class="cls-2" d="M21,15.75v-5.25c0-.825-.675-1.5-1.5-1.5H1.5c-.825,0-1.5,.675-1.5,1.5v15c0,.825,.675,1.5,1.5,1.5H19.5c.825,0,1.5-.675,1.5-1.5v-5.25l6,6V9.75l-6,6Z"/></svg></figure>
            <p class="text">Media</p>
          </div>
        </a>
      </li>
      <li class="list__item">
        <a class="applications-closed anchor" role="link" aria-disabled="true" aria-label="Applications closed">
          <div class="anchor__inner">
            <p class="text">Closed</p>
          </div>
        </a>
      </li>
    </ul>
  </div>
</div>

<script is:inline>
  (function() {
    if (window.__spNavMenuFallbackRegistered) return;
    window.__spNavMenuFallbackRegistered = true;

    function setMenuOpen(isOpen) {
      const modal = document.getElementById('MenuModal');
      const spNav = document.getElementById('SpNav');
      if (!modal || !spNav) return;

      if (isOpen) {
        modal.style.display = 'block';
        spNav.classList.add('is-menuOpen');
        document.documentElement.style.overflow = 'hidden';
        window.requestAnimationFrame(function() {
          modal.classList.add('is-open');
        });
      } else {
        modal.classList.remove('is-open');
        spNav.classList.remove('is-menuOpen');
        document.documentElement.style.overflow = '';
        window.setTimeout(function() {
          if (!modal.classList.contains('is-open')) {
            modal.style.display = '';
          }
        }, 400);
      }
    }

    window.addEventListener('click', function(event) {
      if (event.target.closest('#SpNav .MenuModal--open')) {
        event.preventDefault();
        event.stopPropagation();
        setMenuOpen(true);
      }

      if (event.target.closest('#SpNav .MenuModal--close') || event.target.closest('#MenuModal .MenuModal--close')) {
        event.preventDefault();
        event.stopPropagation();
        setMenuOpen(false);
      }
    }, true);
  })();
</script>
