---
import SubPageLayout from '../layouts/SubPageLayout.astro';
---

<SubPageLayout
  title="About Team 9470"
  description="Meet Ctrl-Alt-Defeat, FRC Team 9470 in Fremont, California. Find out what students do, when we meet, and how to join."
  ogImage="../assets/images/ctrlaltdefeatlogo.png"
  canonicalUrl="https://team9470.com/about"
  currentPage="about"
>
  <link slot="head" href="/assets/css/about-simple.css" rel="stylesheet" type="text/css"/>

        <section class="SectContents SimpleAboutPage" id="SectContents">

          <div class="SectContents__nav f-gen no-pageNav" data-scroll="data-scroll" data-scroll-sticky="data-scroll-sticky" data-scroll-target="#SectContents">
            <div class="SectContents__nav__container">
              <div class="innerNav">
                <ul class="innerNav__list">
                  <li class="innerNav__list__item is-current"><a class="anchor mScroll mo_line" href="#Overview"><div class="anchor__inner"><p class="text">Overview</p><figure class="arrow"></figure></div></a></li>
                  <li class="innerNav__list__item"><a class="anchor mScroll mo_line" href="#Learn"><div class="anchor__inner"><p class="text">Learn</p><figure class="arrow"></figure></div></a></li>
                  <li class="innerNav__list__item"><a class="anchor mScroll mo_line" href="#Commitment"><div class="anchor__inner"><p class="text">Schedule</p><figure class="arrow"></figure></div></a></li>
                  <li class="innerNav__list__item"><a class="anchor mScroll mo_line" href="#Divisions"><div class="anchor__inner"><p class="text">Divisions</p><figure class="arrow"></figure></div></a></li>
                  <li class="innerNav__list__item"><a class="anchor mScroll mo_line" href="#Join"><div class="anchor__inner"><p class="text">Join</p><figure class="arrow"></figure></div></a></li>
                </ul>
              </div>
            </div>
          </div>

          <!-- Overview / Hero -->
          <section class="SectContents__block SimpleAboutHero" id="Overview">
            <div class="SimpleAboutHero__copy">
              <p class="SimpleAboutPage__eyebrow">Ctrl-Alt-Defeat · Fremont, California</p>
              <h1 class="SimpleAboutHero__title">About Team 9470</h1>
              <p class="SimpleAboutHero__lead">We’re a robotics team based at <strong>BASIS Independent Fremont</strong>, open to students from the surrounding community. Each year, we build and program a robot for FIRST Robotics Competition (FRC).</p>
              <p class="SimpleAboutHero__note">Students lead the team’s design, construction, and competition work, with support from mentors and parents.</p>
              <div class="SimpleAboutHero__actions">
                <a class="SimpleAboutButton" href="/divisions/">Divisions</a>
                <a class="SimpleAboutButton" href="/members/">Members</a>
              </div>
            </div>
            <figure class="SimpleAboutHero__image c-inviewImage fInview">
              <img src="/assets/images/Media/teamphoto4.jpg" alt="Team 9470 members together at an event">
            </figure>
          </section>

          <!-- What Is FRC -->
          <section class="SectContents__block SimpleAboutSection" id="FRC">
            <h2 class="SimpleAboutPage__title">How the competition works</h2>
            <p class="SimpleAboutPage__body">FIRST announces a new game each January. We spend the following weeks designing, building, and testing a robot for spring competitions.</p>
            <p class="SimpleAboutPage__body">At events, we compete alongside other teams in alliances. Between matches, students repair the robot, review match data, and plan strategy with our alliance partners.</p>
          </section>

          <!-- What Students Learn -->
          <section class="SectContents__block SimpleAboutWork" id="Learn">
            <div class="SimpleAboutWork__intro">
              <h2 class="SimpleAboutPage__title">What students do</h2>
            </div>
            <ol class="SimpleStepList">
              <li class="SimpleStepList__item" style="--delay: 0ms">
                <span class="SimpleStepList__number">01</span>
                <h3 class="SimpleStepList__title">Engineering</h3>
                <p class="SimpleStepList__body">Design parts with computer-aided design (CAD), machine and assemble them, wire electronics, and program the robot in Java.</p>
              </li>
              <li class="SimpleStepList__item" style="--delay: 90ms">
                <span class="SimpleStepList__number">02</span>
                <h3 class="SimpleStepList__title">Business and outreach</h3>
                <p class="SimpleStepList__body">Contact sponsors, write grant applications, manage the budget, and organize community events.</p>
              </li>
              <li class="SimpleStepList__item" style="--delay: 180ms">
                <span class="SimpleStepList__number">03</span>
                <h3 class="SimpleStepList__title">Media and design</h3>
                <p class="SimpleStepList__body">Photograph competitions, make videos and graphics, and share the team’s work on social media.</p>
              </li>
              <li class="SimpleStepList__item" style="--delay: 270ms">
                <span class="SimpleStepList__number">04</span>
                <h3 class="SimpleStepList__title">Team leadership</h3>
                <p class="SimpleStepList__body">Plan work sessions, coordinate tasks across divisions, and teach newer members how to use tools and equipment.</p>
              </li>
            </ol>
          </section>

          <!-- Time Commitment -->
          <section class="SectContents__block SimpleAboutSection" id="Commitment">
            <h2 class="SimpleAboutPage__title">Schedule</h2>
            <div class="SimpleAboutAction">
              <div class="SimpleAboutAction__item SimpleAboutReveal">
                <p>Offseason<br>Saturdays 9 AM – 4 PM<br>Some Sundays added as needed</p>
              </div>
              <div class="SimpleAboutAction__item SimpleAboutReveal">
                <p>Build season<br>Weekdays 4 – 9 PM<br>Weekends 9 AM – 5 PM</p>
              </div>
              <div class="SimpleAboutAction__item SimpleAboutReveal">
                <p>Spring competitions<br>Full-day weekend events<br>Early mornings and possible overnight travel</p>
              </div>
              <div class="SimpleAboutAction__item SimpleAboutReveal">
                <p>Competition attendance<br>Spots depend on attendance, completed training, contributions to the team, safety, and reliability.</p>
              </div>
            </div>
          </section>

          <!-- Team Divisions -->
          <section class="SectContents__block SimpleAboutSection" id="Divisions">
            <h2 class="SimpleAboutPage__title">Divisions</h2>
            <p class="SimpleAboutPage__body">Each student joins a primary division and can help with work in other divisions. Design students often learn fabrication, and software students help test the robot.</p>
            <div class="SimpleAboutHero__actions SimpleAboutReveal">
              <a class="SimpleAboutButton" href="/divisions/">Read about our divisions</a>
            </div>
          </section>

          <!-- Why Join -->
          <section class="SectContents__block SimpleAboutSection SimpleAboutSection--last" id="Join">
            <h2 class="SimpleAboutPage__title">Join</h2>
            <p class="SimpleAboutPage__body">No prior robotics experience is required. You’ll need to attend regularly, follow safety procedures, and be willing to learn.</p>
            <div class="SimpleAboutHero__actions"><a class="applications-closed SimpleAboutButton" role="link" aria-disabled="true" aria-label="Applications closed">Applications closed</a></div>
          </section>

        </section>

</SubPageLayout>
