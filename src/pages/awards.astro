---
import SubPageLayout from '../layouts/SubPageLayout.astro';
---

<SubPageLayout
  title="Team 9470 - Awards"
  description="Team 9470 Ctrl-Alt-Defeat Awards and Competition Results. See our latest achievements, rankings, and event highlights from the FIRST Robotics Competition."
  ogImage="/assets/images/ctrlaltdefeatlogo.png"
  canonicalUrl="https://team9470.com/awards"
  currentPage="awards"
>
  <link slot="head" href="/assets/css/awards.css" rel="stylesheet" type="text/css"/>


<!-- Hero Section -->
<section class="Main Main--fixed" id="Main">
  <canvas class="awards-hero__particles" id="awardsParticles"></canvas>
  <div class="awards-hero__marquee" aria-hidden="true">
    <div class="awards-hero__marquee-track">
      <span class="awards-hero__marquee-text">AWARDS &amp; RESULTS&nbsp;&mdash;&nbsp;</span>
      <span class="awards-hero__marquee-text">AWARDS &amp; RESULTS&nbsp;&mdash;&nbsp;</span>
      <span class="awards-hero__marquee-text">AWARDS &amp; RESULTS&nbsp;&mdash;&nbsp;</span>
      <span class="awards-hero__marquee-text">AWARDS &amp; RESULTS&nbsp;&mdash;&nbsp;</span>
    </div>
  </div>
  <div class="awards-hero">
    <div class="awards-hero__badge">
      <svg viewBox="0 0 24 24"><path d="M12 2L15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2Z"/></svg>
      2026 SEASON
    </div>
    <h1 class="awards-hero__title">Awards &amp; Results</h1>
    <p class="awards-hero__subtitle">Team 9470 &mdash; Ctrl-Alt-Defeat | 2026 season: <strong style="color:#fff;">60-13-0</strong>, CA District <strong style="color:#fff;">#6</strong>, Archimedes Division Winner</p>
  </div>
</section>


<!-- Season Overview -->
<div class="SectContents" id="SectContents">
  <div class="SectContents__top overlay-circle overlay-circle--gray">

    <section class="awards-season">
      <div class="awards-container">
        <div class="awards-season__header awards-fade-up fInview">
          <p class="awards-season__year">2026 Season Overview</p>
          <h2 class="awards-season__heading">A Breakout Run</h2>
          <p class="awards-season__record">Team 9470 went <strong>60-13-0</strong>, earned <strong>313 district points</strong>, finished <strong>#6</strong> in the California District, won two district events, captained a state finalist alliance, won Archimedes, and reached Einstein.</p>
        </div>

        <!-- Stats -->
        <div class="stats-grid awards-stagger-parent fInview">
          <div class="stat-card awards-stagger-child awards-tilt">
            <div class="stat-card__number" data-count-prefix="#" data-count-to="6">0</div>
            <div class="stat-card__label">Final CA District Rank</div>
          </div>
          <div class="stat-card awards-stagger-child awards-tilt">
            <div class="stat-card__number" data-count-text="60-13-0">0-0-0</div>
            <div class="stat-card__label">Overall Record</div>
          </div>
          <div class="stat-card awards-stagger-child awards-tilt">
            <div class="stat-card__number" data-count-to="313">0</div>
            <div class="stat-card__label">District Points</div>
          </div>
          <div class="stat-card awards-stagger-child awards-tilt">
            <div class="stat-card__number" data-count-to="885">0</div>
            <div class="stat-card__label">Highest Alliance Score</div>
          </div>
        </div>
        <!-- Week-by-Week Progression -->
        <div class="progression-grid awards-fade-up fInview">
          <div class="progression-card">
            <div class="progression-card__label">Season Arc</div>
            <div class="progression-card__value">2 Wins &rarr; State Finalist &rarr; Archimedes Winner</div>
            <div class="progression-card__note">Districts to Championship</div>
          </div>
          <div class="progression-card">
            <div class="progression-card__label">District Points</div>
            <div class="progression-card__value">70 &rarr; 142 &rarr; 313</div>
            <div class="progression-card__note">Half Moon Bay, Silicon Valley, State Championship</div>
          </div>
          <div class="progression-card">
            <div class="progression-card__label">Highest Match Score</div>
            <div class="progression-card__value">720 &rarr; 725 &rarr; 885</div>
            <div class="progression-card__note">Peak set at Archimedes</div>
          </div>
          <div class="progression-card">
            <div class="progression-card__label">Official Record</div>
            <div class="progression-card__value">14-3-0 &rarr; 30-4-0 &rarr; 60-13-0</div>
            <div class="progression-card__note">Final official record</div>
          </div>
        </div>

        <!-- Event Cards -->
        <div class="event-section awards-scale-in fInview">
          <details class="event-accordion awards-fade-up fInview">
            <summary class="event-accordion__summary">
              <div class="event-accordion__summary-main">
                <div class="event-accordion__week">Week 1</div>
                <div class="event-accordion__name">CA District Half Moon Bay Event</div>
                <div class="event-accordion__meta">March 6 &ndash; 8, 2026 &middot; Rank 3 &middot; Record 14-3-0</div>
              </div>
              <span class="event-accordion__chevron" aria-hidden="true"></span>
            </summary>
            <div class="event-card">
              <div class="event-card__header">
                <div class="event-card__winner-badge">
                  <svg viewBox="0 0 24 24"><path d="M5 16L3 5l5.5 5L12 4l3.5 6L21 5l-2 11H5zm14 3c0 .6-.4 1-1 1H6c-.6 0-1-.4-1-1v-1h14v1z"/></svg>
                  Event Winner
                </div>
                <h3 class="event-card__event-name">CA District Half Moon Bay Event</h3>
                <div class="event-card__event-meta">
                  <span>
                    <svg viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
                    Half Moon Bay, CA, USA
                  </span>
                  <span>
                    <svg viewBox="0 0 24 24"><path d="M19 3h-1V1h-2v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11zM9 10H7v2h2v-2zm4 0h-2v2h2v-2zm4 0h-2v2h2v-2z"/></svg>
                    March 6 &ndash; 8, 2026 &middot; Week 1
                  </span>
                  <span>
                    <svg viewBox="0 0 24 24"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/></svg>
                    Rank 3 &middot; Alliance 1, 1st Pick
                  </span>
                </div>
              </div>
              <div class="event-card__body">
                <div class="alliance-section">
                  <h4 class="alliance-section__title">Awards Won</h4>
                </div>
                <div class="awards-list awards-stagger-parent fInview">
                  <div class="award-item awards-stagger-child">
                    <div class="award-item__icon">
                      <svg viewBox="0 0 24 24"><path d="M5 16L3 5l5.5 5L12 4l3.5 6L21 5l-2 11H5zm14 3c0 .6-.4 1-1 1H6c-.6 0-1-.4-1-1v-1h14v1z"/></svg>
