---
import SubPageLayout from '../layouts/SubPageLayout.astro';
import { season2026, events2026, selectedMatches, previousSeasons } from '../data/competition';
import '../styles/results.css';
const photos = [
  { file: 'half-moon-bay', original: '5f167d2e-e3a5-4854-bf85-108a17bb402b.JPG', caption: 'Half Moon Bay event winners', alt: 'Team 9470 with their robot and Half Moon Bay winner banner' },
  { file: 'winner-banner', original: '6bb56584-c7c0-4a2f-b8e6-c155a71f1002.JPG', caption: 'Team photo with the winner banner', alt: 'Team members holding the blue FIRST winner banner' },
  { file: 'pit-huddle', original: '9274c294-1399-4c15-8f54-d9d5ecc544e5.JPG', caption: 'Team huddle', alt: 'Team 9470 huddling together at competition' },
  { file: 'heading-to-field', original: 'b7de1c4e-adb4-4037-a726-921081862553.JPG', caption: 'Heading to the field', alt: 'Team 9470 members walking near the competition field' },
  { file: 'engineering-award', original: 'f78ba268-0137-424e-957b-ffc5aa0e6d04.JPG', caption: 'Excellence in Engineering Award', alt: 'Team 9470 receiving the Excellence in Engineering Award' },
];
---
<SubPageLayout title="Awards & Results | Team 9470" description="Team 9470 competition results and awards from 2024–2026, including the 2026 Archimedes Division win at the FIRST Championship." canonicalUrl="https://team9470.com/awards/" ogImage="https://team9470.com/assets/images/Media/archimedes_winners.jpg" currentPage="awards">
  <main class="ResultsPage">
    <div class="results-wrap">
      <header class="results-heading">
        <h1>Awards &amp; results</h1>
        <nav aria-label="On this page">
          <a href="#season-2026">2026 season</a>
          <a href="#matches">Selected matches</a>
          <a href="#history">Past seasons</a>
          <a href="#photos">Photos</a>
        </nav>
      </header>

      <section class="results-season" id="season-2026" aria-labelledby="season-title">
        <div class="results-season-copy">
          <h2 id="season-title">2026 season</h2>
          <p>We won the Half Moon Bay and Silicon Valley district events, followed by the Archimedes Division at the FIRST Championship.</p>
          <p>Our Archimedes alliance advanced to Einstein, the Championship playoffs between division winners.</p>
          <dl class="results-stats">
            <div><dt>Official record</dt><dd>{season2026.record.join('–')}</dd></div>
            <div><dt>California district rank</dt><dd>#{season2026.districtRank}</dd></div>
            <div><dt>District points</dt><dd>{season2026.districtPoints}</dd></div>
          </dl>
          <a class="results-link" href={season2026.tbaUrl}>Full 2026 results</a>
        </div>
        <figure class="results-season-photo">
          <img src="/assets/images/Media/archimedes_winners.jpg" alt="Team 9470 holding their 2026 Archimedes Division winner banner in Houston" width="1024" height="768" fetchpriority="high" />
          <figcaption>Archimedes Division winners · Houston, May 2026</figcaption>
        </figure>
      </section>

      <section class="results-section" aria-labelledby="events-title">
        <div class="results-section-heading">
          <h2 id="events-title">Event results</h2>
          <p>Official 2026 events. Records are wins–losses–ties.</p>
        </div>
        <div class="results-events">
          {events2026.map((event) => (
            <details class="results-event" id={event.id}>
              <summary>
                <div class="results-event-name">
                  <h3>{event.name}</h3>
                  <p>{event.date} · {event.location}</p>
                  {event.award && <p class="results-judged-award">{event.award}</p>}
                </div>
                <span class="results-outcome">{event.result}</span>
                <span class="results-record" aria-label={`${event.record[0]} wins, ${event.record[1]} losses, ${event.record[2]} ties`}>{event.record.join('–')}</span>
                <span class="results-disclosure" aria-hidden="true"></span>
              </summary>
              <div class="results-event-body">
                <div>
                  <h4>{event.allianceName}</h4>
                  <dl class="results-alliance">
                    {event.alliance.map((member) => (<div><dt>{member.role}</dt><dd><a href={`https://www.thebluealliance.com/team/${member.team}/2026`} class:list={{ 'results-our-team': member.team === 9470 }}>{member.team}</a></dd></div>))}
                  </dl>
                </div>
                <div class="results-event-facts">
                  {event.rank && <p><strong>Qualification rank:</strong> {event.rank}</p>}
                  {event.note && <p>{event.note}</p>}
                  {event.awardSponsor && <p>{event.awardSponsor}</p>}
                  {event.presentedBy && <p>{event.presentedBy}</p>}
                  {event.points && <div class="results-points"><h4>{event.points.total} district points</h4><p>Qualification {event.points.qualification} · Alliance selection {event.points.alliance} · Playoffs {event.points.playoff} · Awards {event.points.award}</p></div>}
                  <a class="results-link" href={event.url}>Full event results</a>
                </div>
              </div>
            </details>
          ))}
        </div>
      </section>

      <section class="results-section" id="matches" aria-labelledby="matches-title">
        <div class="results-section-heading"><h2 id="matches-title">Selected matches</h2><p>Team 9470’s alliance is listed first in each score.</p></div>
        <ul class="results-matches">
          {selectedMatches.map((match) => (
            <li>
              <div class="results-match-name"><h3><a href={`https://www.thebluealliance.com/match/${match.key}`}>{match.event}</a></h3><p>{match.match}</p></div>
              <div class="results-match-teams"><p><strong>{match.alliance.join(' · ')}</strong></p><p>vs. {match.opponents.join(' · ')}</p></div>
              <p class="results-score" aria-label={`Team 9470’s alliance ${match.ours}, opposing alliance ${match.theirs}`}><strong>{match.ours}</strong><span aria-hidden="true">–</span><span>{match.theirs}</span></p>
            </li>
          ))}
        </ul>
      </section>

      <section class="results-section" id="history" aria-labelledby="history-title">
        <h2 id="history-title">Past seasons</h2>
        <div class="results-history">
          {previousSeasons.map((season) => (
            <article>
              <div><h3>{season.year}</h3><p>{season.game}</p></div>
              <ul>{season.awards.map((award) => (<li><h4>{award.name}</h4><p>{award.event}</p></li>))}</ul>
              <a class="results-link" href={season.url}>{season.year} results on FIRST</a>
            </article>
          ))}
        </div>
      </section>

      <section class="results-section" id="photos" aria-labelledby="photos-title">
        <div class="results-section-heading"><h2 id="photos-title">Competition photos</h2><a class="results-link" href="/media/">More team photos</a></div>
        <div class="results-photos">
          {photos.map((photo) => (
            <figure><a href={`/awards/media/${photo.original}`} aria-label={`Open photo: ${photo.caption}`}><img src={`/awards/media/${photo.file}.webp`} alt={photo.alt} width="800" height="600" loading="lazy" decoding="async" /></a><figcaption>{photo.caption}</figcaption></figure>
          ))}
        </div>
      </section>
      <footer class="results-sources">
        <p>Results: <a href={season2026.firstUrl}>FIRST</a> and <a href={season2026.tbaUrl}>The Blue Alliance</a>. Season records exclude offseason matches.</p>
      </footer>
    </div>
  </main>
</SubPageLayout>
