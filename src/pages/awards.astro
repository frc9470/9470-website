                  <div class="points-card awards-stagger-child awards-tilt">
                    <div class="points-card__value" data-count-to="5">0</div>
                    <div class="points-card__label">Award</div>
                  </div>
                  <div class="points-card points-card--total awards-stagger-child awards-tilt">
                    <div class="points-card__value" data-count-to="70">0</div>
