                    </tr>
                    <tr>
                      <td class="role-cell">2nd Pick</td>
                      <td>7607</td>
                    </tr>
                    <tr>
                      <td class="role-cell">Backup</td>
                      <td>5760</td>
                    </tr>
                  </tbody>
