<body class="page-home">
  <!-- Start .Wrapper -->
  <div class="Wrapper" data-barba="wrapper">

    
    <Header currentPage="home" />
    <SpNav currentPage="home" />

    <!-- Start .Container -->
    <div class="Container">
      <!-- Start .Contents -->
      <div class="Contents" data-scroll-container="data-scroll-container">




<section class="Main" id="Main" data-scroll-section>
  <div class="Main__visual">
    <figure class="movie HeroMovie" data-hero-video>
      <img
        class="HeroMovie__poster"
        src="/assets/images/homepage-hero-poster.jpg"
        alt=""
        decoding="async"
        fetchpriority="high"
        aria-hidden="true"
      />
      <video
        class="fvLoad HeroMovie__video"
        id="heroVideo"
        loop="loop"
        playsinline="playsinline"
        muted="muted"
        preload="none"
        poster="/assets/images/homepage-hero-poster.jpg"
        data-desktop-src="/assets/images/homepage-hero-desktop.mp4"
        data-desktop-hd-src="/assets/images/homepage-hero-bg.mp4"
        data-mobile-src="/assets/images/homepage-hero-mobile.mp4"
        aria-hidden="true"
      ></video>
      <script is:inline>
        (function() {
          var movie = document.querySelector('[data-hero-video]');
          var v = document.getElementById('heroVideo');
          if (!movie || !v) return;

          var startedLoading = false;
          var revealed = false;
          var objectUrl = null;
          var nativePlay = v.play.bind(v);

          v.play = function() {
            if (!revealed) return Promise.resolve();
            return nativePlay();
          };

          function setStart() {
            try {
              v.currentTime = 0;
            } catch (error) {}
          }

          function selectedVideoSrc() {
            if (window.matchMedia('(max-width: 767px)').matches) {
              return v.dataset.mobileSrc;
            }

            var connection = navigator.connection || navigator.mozConnection || navigator.webkitConnection;
            var saveData = connection && connection.saveData;
            var effectiveType = connection && connection.effectiveType;
            var slowConnection = effectiveType === 'slow-2g' || effectiveType === '2g' || effectiveType === '3g';
            var wideEnoughForHd = window.matchMedia('(min-width: 1024px)').matches;

            return wideEnoughForHd && !saveData && !slowConnection
              ? v.dataset.desktopHdSrc
              : v.dataset.desktopSrc;
          }

          function revealVideo() {
            if (revealed) return;
            if (v.readyState < 2) return;
            revealed = true;
            setStart();
            movie.classList.add('is-video-ready');

            var playAttempt = nativePlay();
            if (playAttempt && typeof playAttempt.catch === 'function') {
              playAttempt.catch(function() {});
            }
          }

          function beginVideoLoad() {
            if (startedLoading) return;
            startedLoading = true;
            var src = selectedVideoSrc();
            movie.classList.add('is-video-loading');

            v.src = src;
            v.dataset.loadedSrc = src;
            v.preload = 'auto';
            v.load();
          }

          v.addEventListener('play', function() {
            if (!revealed) {
              v.pause();
              setStart();
            }
          }, true);

          v.addEventListener('loadedmetadata', function() {
            setStart();
          });
          v.addEventListener('loadeddata', revealVideo);
          v.addEventListener('canplay', revealVideo);
          v.addEventListener('canplaythrough', revealVideo);
          v.addEventListener('error', function() {
            movie.classList.add('is-video-unavailable');
          });
          window.addEventListener('pagehide', function() {
            if (objectUrl) URL.revokeObjectURL(objectUrl);
          });

          if (document.readyState === 'complete') {
            beginVideoLoad();
          } else {
            window.addEventListener('load', beginVideoLoad, { once: true });
          }
        })();
      </script>
    </figure>
    <div class="Main__visual__bottom">
      <div class="HeroContent">
        <h1 class="HeroContent__title">CTRL-ALT-DEFEAT</h1>
        <p class="HeroContent__subtitle">FRC TEAM 9470</p>
      </div>
    </div>
    <div class="ScrollInvitation" onclick="if(window.app && window.app.locoScroll){ window.app.locoScroll.scrollTo('#About'); } else { document.getElementById('About').scrollIntoView({ behavior: 'smooth' }); }">
      <span class="ScrollInvitation__text">SCROLL</span>
