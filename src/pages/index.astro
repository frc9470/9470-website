  z-index: 2;
  background: #e6e6e3;
}

.NavGrid__title {
  text-align: center;
  margin-bottom: 5rem;
}

.NavGrid__title h2 {
  font-family: 'Montserrat', sans-serif;
  font-size: 3rem;
  font-weight: 700;
  color: #202020;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  margin-bottom: 1.5rem;
}

.NavGrid__title p {
  font-family: 'Montserrat', sans-serif;
  font-size: 1.2rem;
  color: #6f6f6d;
  letter-spacing: 0.05em;
}

.NavGrid__container {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2.5rem;
}

@media (max-width: 1024px) {
  .NavGrid__container {
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }
}

@media (max-width: 768px) {
  .NavGrid__container {
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  .NavGrid__title h2 {
    font-size: 2.2rem;
  }
  .NavGrid {
    padding: 5rem 5% 6rem;
  }
}

.NavCard {
  position: relative;
  height: 420px;
  border-radius: 4px;
  overflow: hidden;
  border: 1px solid rgba(0, 0, 0, 0.1);
  background: rgba(255, 255, 255, 0.36);
  backdrop-filter: blur(4px);
  -webkit-backdrop-filter: blur(4px);
  transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  text-decoration: none;
  cursor: pointer;
  box-shadow: 0 2px 16px rgba(0, 0, 0, 0.1);
}

.NavCard::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(to top, rgba(14, 14, 14, 0.95) 0%, rgba(14, 14, 14, 0.4) 50%, rgba(14, 14, 14, 0.15) 100%);
  z-index: 1;
  transition: background 0.4s ease;
}

.NavCard__image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  z-index: 0;
}

.NavCard__content {
  position: relative;
  z-index: 2;
  padding: 2.2rem;
  transform: translateY(1rem);
  transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}

.NavCard__category {
  font-family: 'Montserrat', sans-serif;
  font-size: 0.85rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.15em;
  margin-bottom: 0.6rem;
  display: inline-block;
}

.NavCard__title {
  font-family: 'Montserrat', sans-serif;
  font-size: 1.7rem;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 0.8rem;
  letter-spacing: -0.01em;
}

.NavCard__desc {
  font-size: 0.95rem;
  line-height: 1.6;
  color: rgba(255,255,255,0.82);
  opacity: 0;
  transform: translateY(12px);
  transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}

.NavCard:hover {
  transform: translateY(-6px);
  border-color: rgba(0, 0, 0, 0.18);
  box-shadow: 0 12px 32px rgba(0, 0, 0, 0.16);
}

.NavCard:hover .NavCard__image {
  transform: scale(1.06);
}

.NavCard:hover::before {
  background: linear-gradient(to top, rgba(14, 14, 14, 0.98) 0%, rgba(14, 14, 14, 0.5) 50%, rgba(14, 14, 14, 0.2) 100%);
}

.NavCard:hover .NavCard__content {
  transform: translateY(0);
}

.NavCard:hover .NavCard__desc {
  opacity: 1;
  transform: translateY(0);
}

.NavCard__arrow {
  position: absolute;
  top: 2rem;
  right: 2rem;
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  z-index: 2;
  opacity: 0;
  transform: scale(0.8);
  transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}

.NavCard:hover .NavCard__arrow {
  opacity: 1;
  transform: scale(1);
  background: var(--site-accent);
  border-color: var(--site-accent);
  color: var(--site-accent-ink);
  box-shadow: 0 4px 15px rgba(var(--site-accent-rgb), 0.4);
}

/* Widescreen Banner Card Styles (Global overrides to bypass Astro scoping issues) */
:global(.NavCard.NavCard--banner) {
  grid-column: span 3 !important;
  height: 180px !important;
  flex-direction: row !important;
  align-items: center !important;
  justify-content: space-between !important;
  border: 1.5px solid rgba(var(--site-accent-rgb), 0.75) !important;
  box-shadow: 0 0 25px rgba(var(--site-accent-rgb), 0.2), 0 4px 30px rgba(0, 0, 0, 0.6) !important;
  background: rgba(var(--site-accent-rgb), 0.04) !important;
}

:global(.NavCard.NavCard--banner .NavCard__image) {
  object-position: center 30% !important;
}

:global(.NavCard.NavCard--banner .NavCard__content) {
  padding: 0 4rem !important;
  transform: none !important;
  display: flex !important;
  align-items: center !important;
  height: 100% !important;
}

:global(.NavCard.NavCard--banner .NavCard__category) {
  font-size: 1.05rem !important;
  margin-bottom: 0.5rem !important;
  letter-spacing: 0.2em !important;
}

:global(.NavCard.NavCard--banner .NavCard__title) {
  font-size: 2.8rem !important;
  margin-bottom: 0.5rem !important;
}

:global(.NavCard.NavCard--banner .NavCard__desc) {
  font-size: 1.25rem !important;
  opacity: 1 !important;
  transform: none !important;
  color: #e4e4e7 !important;
}

:global(.NavCard.NavCard--banner .NavCard__arrow) {
  position: static !important;
  opacity: 1 !important;
  transform: none !important;
  margin-right: 4rem !important;
  width: 56px !important;
  height: 56px !important;
  background: var(--site-accent) !important;
  border-color: var(--site-accent) !important;
  color: var(--site-accent-ink) !important;
  box-shadow: 0 4px 15px rgba(var(--site-accent-rgb), 0.4) !important;
}

/* Hover effect on widescreen banner */
:global(.NavCard.NavCard--banner:hover) {
  transform: translateY(-4px) !important;
  border-color: rgba(var(--site-accent-rgb), 1) !important;
  box-shadow: 0 0 35px rgba(var(--site-accent-rgb), 0.45), 0 16px 40px rgba(0, 0, 0, 0.8) !important;
}

:global(.NavCard.NavCard--banner:hover .NavCard__arrow) {
  transform: scale(1.1) !important;
  box-shadow: 0 4px 20px rgba(var(--site-accent-rgb), 0.6) !important;
}

/* Media Queries for Banner Responsiveness */
@media (max-width: 1024px) {
  :global(.NavCard.NavCard--banner) {
    grid-column: span 2 !important;
    padding: 0 1rem !important;
    height: 170px !important;
  }
  :global(.NavCard.NavCard--banner .NavCard__content) {
    padding: 0 2.5rem !important;
  }
  :global(.NavCard.NavCard--banner .NavCard__title) {
    font-size: 2.3rem !important;
  }
  :global(.NavCard.NavCard--banner .NavCard__desc) {
    font-size: 1.15rem !important;
  }
  :global(.NavCard.NavCard--banner .NavCard__arrow) {
    margin-right: 2.5rem !important;
  }
}

@media (max-width: 768px) {
  :global(.NavCard.NavCard--banner) {
    grid-column: span 1 !important;
    height: 420px !important; /* reverts to standard card height */
    flex-direction: column !important;
    align-items: flex-start !important;
    justify-content: flex-end !important;
    padding: 2.2rem !important;
  }
  
  :global(.NavCard.NavCard--banner .NavCard__content) {
    padding: 0 !important;
    height: auto !important;
  }
  
  :global(.NavCard.NavCard--banner .NavCard__title) {
    font-size: 1.7rem !important;
    margin-bottom: 0.8rem !important;
  }
  
  :global(.NavCard.NavCard--banner .NavCard__desc) {
    opacity: 0 !important;
    transform: translateY(12px) !important;
  }
  
  :global(.NavCard.NavCard--banner:hover .NavCard__desc) {
    opacity: 1 !important;
    transform: translateY(0) !important;
  }
  
  :global(.NavCard.NavCard--banner .NavCard__arrow) {
    position: absolute !important;
    top: 2rem !important;
    right: 2rem !important;
    width: 44px !important;
    height: 44px !important;
    opacity: 0 !important;
    transform: scale(0.8) !important;
  }
  
  :global(.NavCard.NavCard--banner:hover .NavCard__arrow) {
    opacity: 1 !important;
    transform: scale(1) !important;
  }
}
</style>
          
