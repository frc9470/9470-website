---
import SubPageLayout from '../layouts/SubPageLayout.astro';
---

<SubPageLayout
  title="Media | Team 9470"
  description="Photo gallery and media from Team 9470 Ctrl-Alt-Defeat."
  canonicalUrl="https://team9470.com/media"
  currentPage="media"
>
  <section class="Main Main--static is-index" id="Main">
    <div class="Main__heading">
      <h1 class="title-ja"><span class="char">T</span><span class="char">E</span><span class="char">A</span><span class="char">M</span></h1>
      <h2 class="title-en"><span class="title-en__inner">Media</span></h2>
    </div>
  </section>

  <section class="SectContents MediaPage" id="SectContents">
    <div class="MediaPage__grid">
      <div class="MediaPage__card">
        <figure class="MediaPage__card__image c-inviewImage fInview">
          <img src="/assets/images/Media/dsc00016.jpg" alt="Competition Team Portrait">
        </figure>
        <div class="MediaPage__card__body">
          <h3 class="MediaPage__card__title">Competition Team Portrait</h3>
          <p class="MediaPage__card__description">Team members posing proudly with the robot next to the alliance station.</p>
        </div>
      </div>
      <div class="MediaPage__card">
        <figure class="MediaPage__card__image c-inviewImage fInview">
          <img src="/assets/images/Media/dsc00089.jpg" alt="Focused in the Pit">
        </figure>
        <div class="MediaPage__card__body">
          <h3 class="MediaPage__card__title">Focused in the Pit</h3>
          <p class="MediaPage__card__description">Analyzing telemetry data and conducting final system checks in the pit.</p>
        </div>
      </div>
      <div class="MediaPage__card">
        <figure class="MediaPage__card__image c-inviewImage fInview">
          <img src="/assets/images/Media/dsc00215.jpg" alt="The Thrill of Victory">
        </figure>
        <div class="MediaPage__card__body">
          <h3 class="MediaPage__card__title">The Thrill of Victory</h3>
          <p class="MediaPage__card__description">Unbridled excitement and celebration after a successful high-scoring match.</p>
        </div>
      </div>
      <div class="MediaPage__card">
        <figure class="MediaPage__card__image c-inviewImage fInview">
          <img src="/assets/images/Media/dsc00430.jpg" alt="Sprinting Across the Field">
        </figure>
        <div class="MediaPage__card__body">
          <h3 class="MediaPage__card__title">Sprinting Across the Field</h3>
          <p class="MediaPage__card__description">Our robot maneuvering at top speed to gather yellow game elements.</p>
        </div>
      </div>
      <div class="MediaPage__card">
        <figure class="MediaPage__card__image c-inviewImage fInview">
          <img src="/assets/images/Media/dsc00438.jpg" alt="Intake Fine-Tuning">
        </figure>
        <div class="MediaPage__card__body">
          <h3 class="MediaPage__card__title">Intake Fine-Tuning</h3>
          <p class="MediaPage__card__description">Drive team members adjusting the intake rollers and sensor alignment.</p>
        </div>
      </div>
      <div class="MediaPage__card">
        <figure class="MediaPage__card__image c-inviewImage fInview">
          <img src="/assets/images/Media/dsc00442.jpg" alt="Pre-Match Loading">
        </figure>
        <div class="MediaPage__card__body">
          <h3 class="MediaPage__card__title">Pre-Match Loading</h3>
          <p class="MediaPage__card__description">Loading game elements into the clear plastic hopper before setting up on the field.</p>
        </div>
      </div>
      <div class="MediaPage__card">
        <figure class="MediaPage__card__image c-inviewImage fInview">
          <img src="/assets/images/Media/dsc00460.jpg" alt="Behind the Glass">
        </figure>
        <div class="MediaPage__card__body">
          <h3 class="MediaPage__card__title">Behind the Glass</h3>
          <p class="MediaPage__card__description">The drive team stands focused behind the alliance station glass during intense play.</p>
        </div>
      </div>
      <div class="MediaPage__card">
        <figure class="MediaPage__card__image c-inviewImage fInview">
          <img src="/assets/images/Media/dsc00536.jpg" alt="Mid-Match Chaos">
        </figure>
        <div class="MediaPage__card__body">
          <h3 class="MediaPage__card__title">Mid-Match Chaos</h3>
          <p class="MediaPage__card__description">A spectacular action shot of game elements showering onto the field.</p>
        </div>
      </div>
      <div class="MediaPage__card">
        <figure class="MediaPage__card__image c-inviewImage fInview">
          <img src="/assets/images/Media/dsc00584.jpg" alt="Alliance Strategy">
        </figure>
        <div class="MediaPage__card__body">
          <h3 class="MediaPage__card__title">Alliance Strategy</h3>
          <p class="MediaPage__card__description">Discussing real-time tactics and coordinating plays during a crucial match.</p>
        </div>
      </div>
      <div class="MediaPage__card">
        <figure class="MediaPage__card__image c-inviewImage fInview">
          <img src="/assets/images/Media/dsc00592.jpg" alt="Back to the Pits">
        </figure>
        <div class="MediaPage__card__body">
          <h3 class="MediaPage__card__title">Back to the Pits</h3>
          <p class="MediaPage__card__description">Carrying the robot off the field after a hard-fought battle to prepare for the next round.</p>
        </div>
      </div>
      <div class="MediaPage__card">
        <figure class="MediaPage__card__image c-inviewImage fInview">
          <img src="/assets/mediaGallery/1.JPG" alt="Our Team Building">
        </figure>
        <div class="MediaPage__card__body">
          <h3 class="MediaPage__card__title">Our Team Building</h3>
          <p class="MediaPage__card__description">Fremont workshop setup and building the chassis.</p>
        </div>
      </div>
      <div class="MediaPage__card">
        <figure class="MediaPage__card__image c-inviewImage fInview">
          <img src="/assets/images/Media/1.jpg" alt="Early competition team photo">
        </figure>
        <div class="MediaPage__card__body">
          <h3 class="MediaPage__card__title">Early Competition Team Photo</h3>
          <p class="MediaPage__card__description">Our team with one of its first competition robots.</p>
        </div>
      </div>
      <div class="MediaPage__card">
        <figure class="MediaPage__card__image c-inviewImage fInview">
          <img src="/assets/images/Media/2.jpeg" alt="Members In Training">
        </figure>
        <div class="MediaPage__card__body">
          <h3 class="MediaPage__card__title">Members In Training</h3>
          <p class="MediaPage__card__description">New members learning critical mechanical and programming skills.</p>
        </div>
      </div>
      <div class="MediaPage__card">
        <figure class="MediaPage__card__image c-inviewImage fInview">
          <img src="/assets/images/Media/3.jpg" alt="Members In Action Building Robot">
        </figure>
        <div class="MediaPage__card__body">
          <h3 class="MediaPage__card__title">Members In Action Building Robot</h3>
          <p class="MediaPage__card__description">Collaborative assembly of the main chassis and superstructure.</p>
        </div>
      </div>
      <div class="MediaPage__card">
        <figure class="MediaPage__card__image c-inviewImage fInview">
          <img src="/assets/images/Media/4.jpg" alt="Robot In Action!">
        </figure>
        <div class="MediaPage__card__body">
          <h3 class="MediaPage__card__title">Robot In Action!</h3>
          <p class="MediaPage__card__description">On-field testing and driving during practice sessions.</p>
        </div>
      </div>
      <div class="MediaPage__card">
        <figure class="MediaPage__card__image c-inviewImage fInview">
          <img src="/assets/images/Media/scoringcoral.jpg" alt="Our Robot Scoring Coral">
        </figure>
        <div class="MediaPage__card__body">
          <h3 class="MediaPage__card__title">Our Robot Scoring Coral</h3>
          <p class="MediaPage__card__description">Precise placement of game elements during official matches.</p>
        </div>
      </div>
      <div class="MediaPage__card">
        <figure class="MediaPage__card__image c-inviewImage fInview">
          <img src="/assets/images/Media/teampinnacles.jpg" alt="Team Photo At Pinnacles">
        </figure>
        <div class="MediaPage__card__body">
          <h3 class="MediaPage__card__title">Team Photo At Pinnacles</h3>
          <p class="MediaPage__card__description">Team bonding and retreat at Pinnacles National Park.</p>
        </div>
      </div>
      <div class="MediaPage__card">
        <figure class="MediaPage__card__image c-inviewImage fInview">
          <img src="/assets/images/Media/workingatpit.jpg" alt="Working At The Pit">
        </figure>
        <div class="MediaPage__card__body">
          <h3 class="MediaPage__card__title">Working At The Pit</h3>
          <p class="MediaPage__card__description">Fast-paced troubleshooting and repairs between tournament matches.</p>
        </div>
      </div>
      <div class="MediaPage__card">
        <figure class="MediaPage__card__image c-inviewImage fInview">
          <img src="/assets/images/Media/workingatpit2.jpg" alt="Working At The Pit 2">
        </figure>
        <div class="MediaPage__card__body">
          <h3 class="MediaPage__card__title">Working At The Pit 2</h3>
          <p class="MediaPage__card__description">Wiring audits and driver team briefs under pressure.</p>
        </div>
      </div>
      <div class="MediaPage__card">
        <figure class="MediaPage__card__image c-inviewImage fInview">
          <img src="/assets/images/Media/buildingatworkshop.jpg" alt="Building At the Workshop">
        </figure>
        <div class="MediaPage__card__body">
          <h3 class="MediaPage__card__title">Building At the Workshop</h3>
          <p class="MediaPage__card__description">Machining customized brackets and structures in the off-season.</p>
        </div>
      </div>
      <div class="MediaPage__card">
        <figure class="MediaPage__card__image c-inviewImage fInview">
          <img src="/assets/images/Media/drillinginthescrew.jpg" alt="Drilling In Screws!">
        </figure>
        <div class="MediaPage__card__body">
          <h3 class="MediaPage__card__title">Drilling In Screws!</h3>
          <p class="MediaPage__card__description">Hands-on fabrication and assembly training for newer members.</p>
        </div>
      </div>
      <div class="MediaPage__card">
        <figure class="MediaPage__card__image c-inviewImage fInview">
          <img src="/assets/images/Media/demowork.jpg" alt="Building Demo Structures">
        </figure>
        <div class="MediaPage__card__body">
          <h3 class="MediaPage__card__title">Building Demo Structures</h3>
          <p class="MediaPage__card__description">Constructing full-scale mockups of FRC field elements.</p>
        </div>
      </div>
      <div class="MediaPage__card">
        <figure class="MediaPage__card__image c-inviewImage fInview">
          <img src="/assets/images/Media/demowork2.jpg" alt="Building Demo Parts">
        </figure>
        <div class="MediaPage__card__body">
          <h3 class="MediaPage__card__title">Building Demo Parts</h3>
          <p class="MediaPage__card__description">Milling mock parts for design verification and fit check.</p>
        </div>
      </div>
    </div>
  </section>

  <style slot="head">
    .MediaPage {
      padding: 0 5%;
    }
    .MediaPage__grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
      max-width: 1200px;
      margin: 0 auto;
      padding: 2rem 0 6rem;
    }
    .MediaPage__card {
      background: rgba(255, 255, 255, 0.55);
      border: 1px solid rgba(0, 0, 0, 0.1);
      border-radius: 4px;
      overflow: hidden;
      box-shadow: 0 2px 12px rgba(0, 0, 0, 0.07);
      transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                  box-shadow 0.35s ease,
                  border-color 0.35s ease;
    }
    .MediaPage__card:hover {
      transform: translateY(-4px);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
      border-color: rgba(var(--site-accent-rgb), 0.45);
      background: rgba(255, 255, 255, 0.82);
    }
    .MediaPage__card__image {
      width: 100%;
      height: 240px;
      overflow: hidden;
      margin: 0;
    }
    .MediaPage__card__image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      filter: saturate(0.9) contrast(1.04);
      transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .MediaPage__card:hover .MediaPage__card__image img {
      transform: scale(1.05);
    }
    .MediaPage__card__body {
      padding: 1.4rem 1.4rem 1.6rem;
      border-top: 1px solid rgba(0, 0, 0, 0.07);
    }
    .MediaPage__card__title {
      font-size: 1.3rem;
      font-weight: 700;
      color: #202020;
      margin-bottom: 0.5rem;
      font-family: 'Montserrat', sans-serif;
    }
    .MediaPage__card__description {
      color: #626260;
      font-size: 1.3rem;
      line-height: 1.65;
    }
    @media (max-width: 768px) {
      .MediaPage__grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 1rem;
      }
    }
    @media (max-width: 480px) {
      .MediaPage__grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</SubPageLayout>
