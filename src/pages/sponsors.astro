---
import SubPageLayout from '../layouts/SubPageLayout.astro';
import SupportNav from '../components/SupportNav.astro';
import '../styles/giving.css';
const featured = [
  { tier: 'Platinum', sponsors: [
    { name: 'FIRST', note: 'FRC Grant · $6,000', logo: 'frc_crop.png' },
    { name: 'Shokz', note: '$5,000', logo: 'Shokz.png' },
    { name: 'DreamFace', note: '$5,000', logo: 'DreamFace.png' },
  ] },
  { tier: 'Gold', sponsors: [
    { name: 'NASA', note: 'NASA Grant · $4,000', logo: 'NASA_crop.png' },
    { name: 'BASIS Independent Fremont Upper', note: '$3,000', logo: 'basis.png' },
    { name: 'Gene Haas Foundation', note: '$2,750', logo: 'genehaas_crop.png' },
  ] },
];
const community = [
  { tier: 'Silver', sponsors: [
    { name: 'Argosy Foundation', amount: '$2,000' },
    { name: 'Minerva IP Law LLC', amount: '$1,000' },
    { name: 'Metis IP LLC', amount: '$1,000' },
    { name: 'PG&E', amount: '$750' },
    { name: 'FIRST NorCal', amount: '$500' },
  ] },
  { tier: 'Bronze', sponsors: [{ name: 'Elite International Consulting', amount: '$250' }] },
];
---
<SubPageLayout currentPage="sponsors" title="Our Sponsors | Team 9470" canonicalUrl="https://team9470.com/sponsors/" description="Meet the sponsors, grant partners, and manufacturing partners supporting Ctrl-Alt-Defeat, FRC Team 9470.">
  <main class="GivingPage">
    <div class="giving-wrap">
      <SupportNav current="sponsors" />
      <header class="giving-hero giving-hero--simple">
        <h1>Our sponsors</h1>
        <p class="giving-lead">Thank you to our sponsors for supporting Team 9470.</p>
        <a class="giving-text-link" href="/support/#sponsorship">Become a sponsor</a>
      </header>

      {featured.map((group) => (
        <section class="sponsor-group" aria-label={`${group.tier} sponsors`}>
          <h2>{group.tier}</h2>
          <ul class="sponsor-grid">
            {group.sponsors.map((sponsor) => (
              <li class="sponsor-card">
                <div class="sponsor-logo"><img src={`/assets/images/${sponsor.logo}`} alt={`${sponsor.name} logo`} loading="lazy" width="280" height="120" /></div>
                <h3>{sponsor.name}</h3>
                <p>{sponsor.note}</p>
              </li>
            ))}
          </ul>
        </section>
      ))}

      <div class="sponsor-community">
        {community.map((group) => (
          <section class="sponsor-group" aria-label={`${group.tier} sponsors`}>
            <h2>{group.tier}</h2>
            <ul class="sponsor-list">
              {group.sponsors.map((sponsor) => (<li><h3>{sponsor.name}</h3><p>{sponsor.amount}</p></li>))}
            </ul>
          </section>
        ))}
      </div>

      <section class="giving-section giving-split sponsor-partner" id="fabworks" aria-labelledby="partner-title">
        <div><h2 id="partner-title">Manufacturing partner</h2><p>Fabworks provides sheet metal parts for our robots. We’re grateful for their support in bringing our designs to the competition field.</p></div>
        <a class="sponsor-partner-link" href="https://www.fabworks.com/" aria-label="Visit Fabworks">
          <img src="/assets/images/fabworks.svg" alt="Fabworks" width="316" height="50" />
          <span>Visit Fabworks</span>
        </a>
      </section>
    </div>
  </main>
</SubPageLayout>
