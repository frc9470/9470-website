---
import SubPageLayout from '../layouts/SubPageLayout.astro';
import SupportNav from '../components/SupportNav.astro';
import '../styles/giving.css';
const tiers = [
  { name: 'Platinum', amount: '$5,000+', benefits: 'Prominent logo on the robot, merchandise, banner, and website. Social media and event recognition, a thank-you letter, and opportunities to collaborate with the team.' },
  { name: 'Gold', amount: '$2,500–$4,999', benefits: 'Large logo on the robot, merchandise, banner, and website. Social media and event recognition, plus a thank-you letter.' },
  { name: 'Silver', amount: '$500–$2,499', benefits: 'Logo on the robot, merchandise, and banner. Website recognition and a thank-you letter.' },
  { name: 'Bronze', amount: 'Under $500', benefits: 'Website recognition and a thank-you letter.' },
];
---
<SubPageLayout currentPage="support" title="Support Us | Team 9470" canonicalUrl="https://team9470.com/support/" description="Support student-built robotics. Donate, become a sponsor, or share your expertise with Ctrl-Alt-Defeat, FRC Team 9470.">
  <main class="GivingPage">
    <div class="giving-wrap">
      <SupportNav current="support" />
      <section class="giving-hero">
        <div>
          <h1>Support Team 9470</h1>
          <p class="giving-lead">Help us cover the cost of building our robot and competing in FIRST Robotics Competition.</p>
          <div class="giving-actions">
            <a class="giving-button" href="#donate">Make a donation</a>
            <a class="giving-text-link" href="#sponsorship">Become a sponsor</a>
          </div>
        </div>
        <figure class="giving-photo">
          <img src="/assets/images/support.JPG" alt="Team 9470 students working together with tools outdoors" width="1200" height="900" />
        </figure>
      </section>

      <section class="giving-section giving-split" id="donate" aria-labelledby="donate-title">
        <div>
          <h2 id="donate-title">Donations</h2>
          <p>Contributions fund robot parts, tools, competition registration, travel, outreach, and student training.</p>
          <aside class="giving-nonprofit">
            <h3>Where to send your donation</h3>
            <p>Send donations to Fremont Institute of Robotics Education (FIRE), the nonprofit that supports our team.</p>
            <p><strong>EIN:</strong> 93-3114186</p>
            <a class="giving-text-link" href="https://www.fremontinstitute.org/" target="_blank" rel="noopener noreferrer">About FIRE</a>
          </aside>
        </div>
        <div class="giving-methods">
          <article>
            <h3>Zelle</h3>
            <p>In your banking app, send to:</p>
            <p class="giving-address">give@fremontinstitute.org</p>
            <p>Include “Ctrl-Alt-Defeat, Team 9470” in the note.</p>
          </article>
          <article>
            <h3>Check</h3>
            <p>Payable to <strong>Fremont Institute of Robotics Education</strong>.</p>
            <address>4285 Santa Monica Terrace<br />Fremont, California</address>
            <p>Memo: Team Support for Robotics Team #9470</p>
          </article>
          <article>
            <h3>Employer matching</h3>
            <p>Look for Fremont Institute of Robotics Education in your employer’s giving portal using EIN 93-3114186. Designate “Ctrl-Alt-Defeat, Team 9470.”</p>
          </article>
          <article>
            <h3>Stock, equipment, or materials</h3>
            <p><a class="giving-text-link" href="mailto:tctrlaltdefeat@gmail.com">Contact the team</a> to arrange stock or in-kind contributions.</p>
          </article>
        </div>
      </section>

      <section class="giving-section" id="sponsorship" aria-labelledby="sponsorship-title">
        <div class="giving-section-heading">
          <h2 id="sponsorship-title">Sponsor Team 9470</h2>
          <a class="giving-text-link" href="/sponsors/">Meet our sponsors</a>
        </div>
        <div class="giving-tiers">
          {tiers.map((tier) => (
            <article class="giving-tier">
              <div><h3>{tier.name}</h3><p class="giving-tier-amount">{tier.amount}</p></div>
              <p>{tier.benefits}</p>
            </article>
          ))}
        </div>
        <a class="giving-button" href="mailto:tctrlaltdefeat@gmail.com?subject=Team%209470%20sponsorship">Email us about sponsorship</a>
      </section>

      <section class="giving-section giving-split giving-volunteer" id="volunteer" aria-labelledby="volunteer-title">
        <h2 id="volunteer-title">Volunteer or mentor</h2>
        <div><p>Mentor students in design, fabrication, software, strategy, or business. Families and volunteers also help with events, transportation, meals, and sponsor introductions.</p>
          <a class="giving-text-link" href="mailto:tctrlaltdefeat@gmail.com?subject=Volunteering%20with%20Team%209470">Email us about volunteering</a>
        </div>
      </section>
    </div>
  </main>
</SubPageLayout>
